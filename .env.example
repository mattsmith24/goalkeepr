# Drizzle
DATABASE_URL=local.db

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="" # no trailing slash
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Toggle the public sign-up form/API.
# Leave unset (or anything other than "false"/"0") to keep sign-ups open.
# Set to "false" or "0" to disable new account creation. Existing users can still sign in.
SIGNUPS_ENABLED=""

# Path prefix the app is served under (e.g. "/goalkeepr" when fronted by a reverse proxy).
# Leave empty when serving from the domain root. The reverse proxy MUST pass the full
# path through to adapter-node (don't strip the prefix) so SvelteKit can match routes.
BASE_PATH=""
